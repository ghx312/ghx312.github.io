KEY = 0x2A

# the expected (encoded) access code
TARGET = [98, 101, 110, 27, 32, 86, 74, 32, 100, 34, 98, 128, 106,
          101, 109, 46, 110, 134, 91, 89, 47, 46, 90, 117, 141, 114,
          53, 105, 53, 116]


def check(code: str) -> bool:
    if len(code) != len(TARGET):
        return False
    for i, ch in enumerate(code):
        # each character is XOR'd with KEY, then the position is added
        if (ord(ch) ^ KEY) + i != TARGET[i]:
            return False
    return True

def decode(target):
    output = []
    for i, ch in enumerate(target):
        output.append((target[i] - i) ^ KEY)

    return output

print("".join(chr(i) for i in decode(TARGET)))